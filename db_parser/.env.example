# Copy this file to db_parser/.env and fill in your values.
# Never commit .env to source control.

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=carrier_bundles
DB_USER=postgres
DB_PASSWORD=changeme

# ---------------------------------------------------------------------------
# GitHub (required for --mode github-issues)
# Fine-grained token needs: Issues → read, Actions → read (for artifacts)
# ---------------------------------------------------------------------------
GITHUB_TOKEN=ghp_your_token_here
GITHUB_REPOSITORY=andmariano/ios-carrier-bundles
